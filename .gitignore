.DS_Store
# Catches the real credentials file no matter where it ends up (it's
# supposed to only ever live at uebersicht/streampulse.jsx, but a stray
# root-level copy got committed once already -- this covers that too).
**/streampulse.jsx
Shared/PlexConfig.swift

# Debug/scratch data -- may contain real session info (IP, username, device
# IDs) pulled from a live Plex server. Never meant to be committed.
_to_delete/
debug_session.json
.plex_widget_debug_session.json
.claude_delete_test.txt

# XcodeGen-generated -- regenerate with `xcodegen generate` (see project.yml)
*.xcodeproj/
App/Info.plist
App/*.entitlements
WidgetExtension/Info.plist
WidgetExtension/*.entitlements
